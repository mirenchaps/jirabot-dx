{
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "type": "AdaptiveCard",
    "version": "1.3",
    "body": [
        {
            "type": "TextBlock",
            "text": "🚀 DX Launch Awareness Release",
            "weight": "Bolder",
            "size": "Large"
        },
        {
            "type": "FactSet",
            "facts": [
                { "title": "Release:", "value": "{RELEASE_NAME}" },
                { "title": "Team:", "value": "{TEAM}" },
                { "title": "Release Date:", "value": "{RELEASE_DATE}" },
                { "title": "Change Request:", "value": "{CR_NUMBER}" }
            ]
        },
        {
            "type": "TextBlock",
            "text": " ",
            "spacing": "small"
        },
        {
            "type": "TextBlock",
            "text": "Deployments ({SHIPPING_STATS}):",
            "weight": "Bolder"
        }
    ],
    "actions": [
        {
            "type": "Action.OpenUrl",
            "title": "Open Release in Jira",
            "url": "{RELEASE_URL}"
        }
    ]
}